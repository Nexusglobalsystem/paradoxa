# Copier vers .env.local et remplir avec les vraies valeurs (jamais commit .env.local).

# Client (exposées au navigateur — clé publishable uniquement, jamais service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origine publique du site (sans slash final) — sert à construire l'URL de
# redirection du lien magique envoyé par Supabase Auth (voir
# app/(vitrine)/compte/connexion/actions.ts). Ex. https://www.laparadoxa.com
# en production ; http://localhost:3000 par défaut si absente en dev.
NEXT_PUBLIC_SITE_URL=

# Serveur uniquement (route handlers / edge functions) — jamais préfixé NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
